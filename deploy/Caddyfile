# Caddy fetches and renews the HTTPS certificate for $DOMAIN automatically,
# as long as the domain's DNS points at this server and ports 80 and 443 are open.
{$DOMAIN} {
	encode zstd gzip
	# Uploads are capped in the app too (MAX_UPLOAD_MB, default 10); this stops anyone
	# streaming a huge body at the Node process. Raise both together if you need bigger files.
	request_body {
		max_size 64MB
	}
	reverse_proxy app:3000
}
