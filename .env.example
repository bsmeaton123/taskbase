# --- Docker / VPS deployment (docker-compose.yml) -----------------------------
# The domain people will use. Point its DNS A record at the server; Caddy gets the
# HTTPS certificate automatically.
DOMAIN=tasks.yourcompany.com
# Password for the bundled Postgres. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App ------------------------------------------------------------------------
# Postgres connection string. Not needed with docker-compose (it builds this from
# POSTGRES_PASSWORD); for local development or a hosted database.
DATABASE_URL=postgres://user:password@localhost:5432/digibooth

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app: https://<DOMAIN> in production
BETTER_AUTH_URL=http://localhost:3100

# Comma-separated company email domains, e.g. "yourcompany.com". When set, only these
# addresses can have accounts, and Google sign-in from these domains works without an invite.
ALLOWED_EMAIL_DOMAINS=

# Sign-up is invite-only by default (admins create links on the People page).
# Set to "true" to let anyone with an ALLOWED_EMAIL_DOMAINS address sign up with a password.
# Note: passwords don't verify email ownership, so prefer invites or Google sign-in.
OPEN_SIGNUP=false

# Required in production: only this address can create the first (admin) account.
# Without it, nobody can sign up on a fresh deploy (so a stranger can't claim admin first).
ADMIN_EMAIL=

# Optional: enable "Continue with Google" sign-in (Google Workspace SSO).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email for notifications, invites and password reset.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM="taskbase <tasks@yourcompany.com>"

# The team's time zone (for the morning reminder email and date defaults).
DEFAULT_TIMEZONE=Europe/London
# Local hour the morning reminder goes out (0 to 23). Default 8.
REMINDER_HOUR=8

# Optional: store attachments on disk instead of in Postgres (needs a persistent volume).
UPLOAD_DIR=
MAX_UPLOAD_MB=10

# Optional: Redbooth import (People > Import from Redbooth). Register an app in Redbooth with the
# callback URL <BETTER_AUTH_URL>/api/redbooth/callback. Without these, admins can paste an access token.
REDBOOTH_CLIENT_ID=
REDBOOTH_CLIENT_SECRET=

# Optional: AI features (catch-ups, notes to tasks, status reports, Ask...), powered by Claude.
# Connects the AI features. Without a key the AI buttons still show and explain that AI
# isn't connected yet. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model to use. Default: claude-opus-5-5
AI_MODEL=
# AI requests allowed per person per hour. Default: 60
AI_HOURLY_LIMIT=60
# Set to "false" to switch AI off and hide every AI button.
AI_ENABLED=

# Optional: post server errors and failed backups to a Slack channel.
# Slack: create an app, turn on Incoming Webhooks, add one for your alerts channel.
SLACK_ALERTS_WEBHOOK_URL=

# --- Backups (docker-compose "backup" service) ------------------------------------
# Daily time (in BACKUP_TZ) for the database backup, and how many days of dumps to keep in ./backups
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_TZ=Europe/London
# Optional but recommended: also copy dumps and uploaded files off the server, to any
# rclone remote. Example for Cloudflare R2 (Backblaze B2 and AWS S3 work the same way):
#   BACKUP_REMOTE=offsite:your-bucket/taskbase
#   RCLONE_CONFIG_OFFSITE_TYPE=s3
#   RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
#   RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=...
#   RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=...
#   RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_REMOTE=
